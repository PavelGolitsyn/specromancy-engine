{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specromancy.dev/schemas/event.schema.json",
  "$comment": "Version and counter fields require JSON integer tokens. Runtime validation also checks calendar dates and record bindings.",
  "title": "Specromancy audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "run_id",
    "visit_number",
    "type",
    "payload",
    "manifest_revision",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "visit_number": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    },
    "type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "payload": {"type": "object"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "action": {
      "required": ["kind", "request_number"],
      "properties": {"kind": {"const": "action"}, "request_number": {"type": "integer", "minimum": 1}}
    },
    "transition": {"required": ["kind"], "properties": {"kind": {"const": "transition"}}},
    "requested": {
      "unevaluatedProperties": false,
      "required": ["reason"],
      "properties": {"reason": {"$ref": "#/$defs/nonblank"}},
      "oneOf": [
        {"$ref": "#/$defs/action"},
        {"$ref": "#/$defs/transition", "required": ["outcome"], "properties": {"outcome": {"$ref": "#/$defs/nonblank"}}}
      ]
    },
    "userDecision": {"required": ["actor"], "properties": {"actor": {"const": "user"}}},
    "granted": {
      "unevaluatedProperties": false, "$ref": "#/$defs/userDecision",
      "oneOf": [
        {"$ref": "#/$defs/action"},
        {"$ref": "#/$defs/transition", "required": ["phase_id"], "properties": {"phase_id": {"$ref": "#/$defs/nonblank"}}}
      ]
    },
    "declined": {
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/userDecision"}]
    },
    "invalidated": {
      "unevaluatedProperties": false,
      "required": ["mismatches"],
      "oneOf": [
        {"$ref": "#/$defs/action", "properties": {"mismatches": {"const": ["pipeline"]}}},
        {"$ref": "#/$defs/transition", "properties": {"mismatches": {"enum": [["artifact"], ["pipeline"], ["artifact", "pipeline"]]}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "approval-requested"}}},
      "then": {"properties": {"visit_number": {"type": "integer"}, "payload": {"$ref": "#/$defs/requested"}}}
    },
    {
      "if": {"properties": {"type": {"const": "approval-granted"}}},
      "then": {"properties": {"visit_number": {"type": "integer"}, "payload": {"$ref": "#/$defs/granted"}}}
    },
    {
      "if": {"properties": {"type": {"const": "approval-declined"}}},
      "then": {"properties": {"visit_number": {"type": "integer"}, "payload": {"$ref": "#/$defs/declined"}}}
    },
    {
      "if": {"properties": {"type": {"const": "approval-invalidated"}}},
      "then": {"properties": {"visit_number": {"type": "integer"}, "payload": {"$ref": "#/$defs/invalidated"}}}
    }
  ]
}
