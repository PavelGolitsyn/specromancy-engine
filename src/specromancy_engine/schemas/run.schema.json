{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specromancy.dev/schemas/run.schema.json",
  "$comment": "Version and counter fields require JSON integer tokens. Runtime validation also checks calendar dates and record bindings.",
  "title": "Specromancy run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "run_id",
    "pipeline",
    "status",
    "current_visit",
    "request",
    "git",
    "created_at",
    "updated_at",
    "visits",
    "approvals",
    "terminal_result",
    "block_reason"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "revision": {"type": "integer", "minimum": 1},
    "run_id": {"$ref": "#/$defs/runId"},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/nonblank"},
        "version": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "status": {"$ref": "#/$defs/status"},
    "current_visit": {
      "oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]
    },
    "request": {"$ref": "#/$defs/sealedArtifact"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {"base": {}, "head": {}}
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "visits": {"type": "array", "items": {"$ref": "#/$defs/visit"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "terminal_result": {},
    "block_reason": {}
  },
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "approval": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["kind", "run_id", "phase_id", "visit_number", "pipeline_sha256", "reason",
                   "details", "requested_at", "status", "decision", "actor", "decided_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/runId"},
        "phase_id": {"$ref": "#/$defs/nonblank"},
        "visit_number": {"type": "integer", "minimum": 1},
        "pipeline_sha256": {"$ref": "#/$defs/hash"},
        "reason": {"$ref": "#/$defs/nonblank"},
        "requested_at": {"$ref": "#/$defs/timestamp"}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "action"}, "details": {"$ref": "#/$defs/nonblank"}}},
        {
          "required": ["artifact_sha256", "outcome"],
          "properties": {
            "kind": {"const": "transition"}, "details": {"type": ["null", "string"]},
            "artifact_sha256": {"$ref": "#/$defs/hash"}, "outcome": {"$ref": "#/$defs/nonblank"}
          }
        }
      ],
      "allOf": [{"oneOf": [
        {"properties": {
          "status": {"const": "pending"}, "decision": {"type": "null"},
          "actor": {"type": "null"}, "decided_at": {"type": "null"}
        }},
        {"properties": {
          "status": {"const": "approved"}, "decision": {"const": "approved"},
          "actor": {"const": "user"}, "decided_at": {"$ref": "#/$defs/timestamp"}
        }},
        {"properties": {
          "kind": {"const": "action"}, "status": {"const": "declined"}, "decision": {"const": "declined"},
          "actor": {"const": "user"}, "decided_at": {"$ref": "#/$defs/timestamp"}
        }},
        {"properties": {
          "status": {"const": "stale"}, "decision": {"const": "invalidated"},
          "actor": {"const": "system"}, "decided_at": {"$ref": "#/$defs/timestamp"}
        }}
      ]}]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "status": {
      "enum": ["active", "awaiting-agent", "awaiting-approval", "paused", "completed", "failed", "blocked"]
    },
    "visitStatus": {
      "enum": ["pending", "active", "awaiting-approval", "completed", "failed", "blocked"]
    },
    "sealedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "path", "sha256"],
      "properties": {
        "reference": {"$ref": "#/$defs/nonblank"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "ordinal",
        "attempt",
        "status",
        "inputs",
        "output",
        "mutation_policy",
        "mutation_baseline",
        "mutation_result",
        "validation_checks",
        "command_results",
        "chosen_outcome",
        "transition_target",
        "skill",
        "template",
        "started_at",
        "completed_at",
        "deviations"
      ],
      "properties": {
        "phase_id": {"$ref": "#/$defs/nonblank"},
        "ordinal": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"$ref": "#/$defs/visitStatus"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/inputArtifact"}},
        "output": {"$ref": "#/$defs/outputArtifact"},
        "mutation_policy": {"enum": ["read-only", "repository-write", "allowlist"]},
        "mutation_baseline": {},
        "mutation_result": {},
        "validation_checks": {"type": "array"},
        "command_results": {"type": "array"},
        "chosen_outcome": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonblank"}]},
        "transition_target": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonblank"}]},
        "skill": {"$ref": "#/$defs/provenance"},
        "template": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
        "started_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "completed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "deviations": {"type": "array"}
      }
    }
  }
}
